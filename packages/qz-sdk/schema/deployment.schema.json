{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quotezero.local/schema/deployment.schema.json",
  "title": "QuoteZero deployment",
  "type": "object",
  "required": ["name", "chainId", "eid", "deployedAt", "startBlock", "owner", "treasury", "contracts", "external"],
  "additionalProperties": false,
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  },
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "chainId": { "type": "integer", "minimum": 1 },
    "eid": { "type": ["integer", "null"] },
    "deployedAt": { "type": ["string", "null"] },
    "startBlock": { "type": "integer", "minimum": 0 },
    "owner": { "$ref": "#/$defs/address" },
    "treasury": { "$ref": "#/$defs/address" },
    "contracts": {
      "type": "object",
      "required": ["QZCore", "QZDarkMirror", "QZEntropy", "QZMachine", "QZCurve", "QZHook", "QZRouter", "QZConverter", "QZRewardVault", "QZCircuit", "QZLiquidityLock"],
      "additionalProperties": false,
      "properties": {
        "QZCore": { "$ref": "#/$defs/address" },
        "QZDarkMirror": { "$ref": "#/$defs/address" },
        "QZEntropy": { "$ref": "#/$defs/address" },
        "QZMachine": { "$ref": "#/$defs/address" },
        "QZCurve": { "$ref": "#/$defs/address" },
        "QZHook": { "$ref": "#/$defs/address" },
        "QZRouter": { "$ref": "#/$defs/address" },
        "QZConverter": { "$ref": "#/$defs/address" },
        "QZRewardVault": { "$ref": "#/$defs/address" },
        "QZCircuit": { "$ref": "#/$defs/address" },
        "QZLiquidityLock": { "$ref": "#/$defs/address" },
        "QZMachineAdapter": { "$ref": "#/$defs/address" },
        "QZTokenAdapter": { "$ref": "#/$defs/address" },
        "QZMachineONFT": { "$ref": "#/$defs/address" },
        "QZTokenOFT": { "$ref": "#/$defs/address" }
      }
    },
    "external": { "type": "object", "additionalProperties": { "$ref": "#/$defs/address" } },
    "poolId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "spokes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["eid", "machine", "token"],
        "additionalProperties": false,
        "properties": {
          "eid": { "type": "integer" },
          "machine": { "$ref": "#/$defs/address" },
          "token": { "$ref": "#/$defs/address" }
        }
      }
    }
  }
}
