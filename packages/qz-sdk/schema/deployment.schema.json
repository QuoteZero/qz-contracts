{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quotezero.local/schema/deployment.schema.json",
  "title": "QuoteZero deployment",
  "type": "object",
  "required": ["name", "chainId", "eid", "deployedAt", "startBlock", "explorer", "owner", "treasury", "roles", "schedule", "contracts", "external", "pons"],
  "additionalProperties": false,
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  },
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "chainId": { "type": "integer", "minimum": 1 },
    "eid": { "type": "integer", "minimum": 1 },
    "deployedAt": { "type": "string" },
    "startBlock": { "type": "integer", "minimum": 0 },
    "explorer": { "type": "string" },
    "owner": { "$ref": "#/$defs/address" },
    "treasury": { "$ref": "#/$defs/address" },
    "roles": {
      "type": "object",
      "required": ["pauser", "revealer", "keeper", "executor"],
      "additionalProperties": false,
      "properties": {
        "pauser": { "$ref": "#/$defs/address" },
        "revealer": { "$ref": "#/$defs/address" },
        "keeper": { "$ref": "#/$defs/address" },
        "executor": { "$ref": "#/$defs/address" }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["mintWindows", "mintStart", "lightingOpensAt", "onionLength"],
      "additionalProperties": false,
      "properties": {
        "mintWindows": {
          "type": "object",
          "required": ["gtd", "fcfs", "publicMax"],
          "additionalProperties": false,
          "properties": {
            "gtd": { "type": "integer", "minimum": 1 },
            "fcfs": { "type": "integer", "minimum": 1 },
            "publicMax": { "type": "integer", "minimum": 1 }
          }
        },
        "mintStart": { "type": "integer", "minimum": 0 },
        "lightingOpensAt": { "type": "integer", "minimum": 0 },
        "onionLength": { "type": "integer", "minimum": 1 }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["QZMachine", "QZForge", "QZEntropy", "QZFeeSplitter", "QZConverter", "QZRewardVault"],
      "additionalProperties": false,
      "properties": {
        "QZMachine": { "$ref": "#/$defs/address" },
        "QZForge": { "$ref": "#/$defs/address" },
        "QZEntropy": { "$ref": "#/$defs/address" },
        "QZFeeSplitter": { "$ref": "#/$defs/address" },
        "QZConverter": { "$ref": "#/$defs/address" },
        "QZRewardVault": { "$ref": "#/$defs/address" }
      }
    },
    "external": { "type": "object", "additionalProperties": { "$ref": "#/$defs/address" } },
    "pons": {
      "type": "object",
      "required": ["factory", "escrow", "hook", "token"],
      "additionalProperties": false,
      "properties": {
        "factory": { "$ref": "#/$defs/address" },
        "escrow": { "$ref": "#/$defs/address" },
        "hook": { "$ref": "#/$defs/address" },
        "token": { "$ref": "#/$defs/address" }
      }
    },
    "verified": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "testnetMocks": { "type": "object" }
  }
}
